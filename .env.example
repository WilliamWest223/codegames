# Variable NAMES only; never commit values. Copy to .env.local and fill in locally.
# Never put a secret in a VITE_* variable: those are bundled and ship to the browser.

# client-safe
VITE_SUPABASE_URL=
# client-safe
VITE_SUPABASE_PUBLISHABLE_KEY=

# SERVER-ONLY
SUPABASE_URL=
# SERVER-ONLY
SUPABASE_SECRET_KEY=
# SERVER-ONLY
GRADER_HMAC_SECRET=
